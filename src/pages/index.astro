---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PixelSprite from "@/components/ui/PixelSprite.astro";
import Hud from "@/components/hud/Hud.astro";
import Hero from "@/components/hero/Hero.astro";
import About from "@/components/sections/About.astro";
import Skills from "@/components/sections/Skills.astro";
import Projects from "@/components/sections/Projects.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/layout/Footer.astro";
import ToTop from "@/components/layout/ToTop.astro";
---

<BaseLayout>
  <PixelSprite />
  <Hud />
  <main id="main">
    <Hero />
    <About />
    <Skills />
    <Projects />
    <Contact />
  </main>
  <Footer />
  <ToTop />
</BaseLayout>

<script>
  // Aparición por scroll: preocupación global de página, por eso se inicializa
  // aquí una sola vez para todos los elementos `.reveal` del sitio.
  import { initReveal } from "@/scripts/reveal";
  import { initParallax } from "@/scripts/parallax";
  initReveal();
  initParallax();
</script>
