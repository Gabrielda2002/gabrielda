---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="404 — Ruta no encontrada" noindex={true}>
  <main id="main" class="nf-page">
    <div class="panel nf">
      <h1>¡Ruta no encontrada!</h1>
      <p>La página que buscas no existe o fue movida.</p>
      <Button variant="primary" href="/">
        Volver al inicio
      </Button>
    </div>
  </main>
</BaseLayout>

<style>
  .nf-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 96px 24px 24px;
  }
  .nf {
    padding: 40px 32px;
    max-width: 460px;
    text-align: center;
  }
  .nf h1 {
    font: 900 20px/1.3 var(--font-pix);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .nf p {
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 24px;
  }
</style>
