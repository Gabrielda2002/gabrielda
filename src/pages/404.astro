---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PixelSprite from "@/components/ui/PixelSprite.astro";
import TechSprite from "@/components/ui/TechSprite.astro";
import Hud from "@/components/hud/Hud.astro";
import WorldScene from "@/components/hero/WorldScene.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
---

<BaseLayout title="404 — Sector No Encontrado" noindex={true}>
  <PixelSprite />
  <TechSprite />
  <Hud />

  <main id="main" class="nf-page">
    <WorldScene />

    <div class="wrap nf-in">
      <section class="nf-card panel" aria-labelledby="nf-title">
        <!-- Barra de estado superior del monitor -->
        <div class="nf-kicker">
          <span class="kicker-dot" aria-hidden="true">◆</span>
          <span>ALERTA DE SISTEMA · CÓDIGO 0x404</span>
        </div>

        <!-- Título principal pixel-art -->
        <h1 class="nf-title" id="nf-title">
          <span class="nf-code">404</span>
          <span class="nf-subtitle">SECTOR NO ENCONTRADO</span>
        </h1>

        <!-- Monitor de radar / diagnóstico -->
        <div class="nf-monitor panel-sunken">
          <div class="radar-box" aria-hidden="true">
            <span class="radar-cross"></span>
            <span class="radar-dot"></span>
          </div>

          <div class="monitor-info">
            <div class="monitor-badges">
              <span class="badge-lost">SEÑAL PERDIDA</span>
              <span class="badge-code">ERR_MAP_BOUNDARY</span>
            </div>
            <p class="monitor-route">
              <span class="route-label">COORDENADA:</span>
              <code id="nfRoute" class="route-code">...</code>
            </p>
            <p class="monitor-desc">
              COORDENADA FUERA DE LOS LÍMITES DE MEMORIA DEL CARTUCHO
            </p>
          </div>
        </div>

        <!-- Cuadro de diálogo estilo RPG retro -->
        <div class="nf-dialog panel">
          <span class="dialog-speaker">SISTEMA</span>
          <p>
            ¡Atención! Te has adentrado en la <strong>hierba alta</strong> fuera
            de los límites del mapa. La ruta que buscas no existe o fue movida en
            una actualización del firmware.
            <span class="caret" aria-hidden="true"></span>
          </p>
        </div>

        <!-- Botonera de rescate rápido -->
        <div class="nf-actions">
          <Button variant="primary" href="/">
            <Icon name="i-play" />
            Volver a la base
          </Button>
          <Button variant="secondary" href="/#proyectos">
            <Icon name="i-repo" />
            Ver proyectos
          </Button>
          <Button variant="secondary" href="/#contacto">
            <Icon name="i-mail" />
            Contactar
          </Button>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  // Detecta en el cliente la ruta que intentó consultar el usuario
  const routeEl = document.getElementById("nfRoute");
  if (routeEl && typeof window !== "undefined") {
    routeEl.textContent = window.location.pathname || "/desconocido";
  }
</script>

<style>
  .nf-page {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 120px 24px 64px;
    overflow: hidden;
  }

  .nf-in {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  .nf-card {
    padding: 36px 32px 32px;
    text-align: left;
    background: var(--panel);
  }

  /* Kicker */
  .nf-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 11px/1 var(--font-mono);
    letter-spacing: 0.22em;
    color: var(--coral);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .kicker-dot {
    font-size: 10px;
    animation: blink-dot 1.2s steps(2) infinite;
  }

  @keyframes blink-dot {
    50% {
      opacity: 0.2;
    }
  }

  /* Título */
  .nf-title {
    margin-bottom: 24px;
  }

  .nf-code {
    display: block;
    font: 900 clamp(44px, 8vw, 76px) / 1 var(--font-pix);
    letter-spacing: -0.01em;
    color: #ffffff;
    text-shadow:
      4px 0 0 var(--line),
      0 4px 0 var(--line),
      6px 6px 0 var(--coral);
  }

  :global([data-theme="night"]) .nf-code {
    color: var(--ink);
  }

  .nf-subtitle {
    display: block;
    margin-top: 8px;
    font: 900 clamp(16px, 3.2vw, 24px) / 1.2 var(--font-pix);
    letter-spacing: -0.01em;
    color: var(--sun);
    text-transform: uppercase;
    text-shadow:
      3px 0 0 var(--line),
      0 3px 0 var(--line),
      5px 5px 0 var(--line);
  }

  /* Monitor de Radar */
  .nf-monitor {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 20px;
    margin-bottom: 24px;
    border: 3px solid var(--line);
    background-color: var(--panel-2);
    background-image: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15) 0 1px,
      transparent 1px 3px
    );
  }

  .radar-box {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border: 2px dashed var(--blue);
    border-radius: 50%;
    position: relative;
    display: grid;
    place-items: center;
    animation: radar-spin 8s steps(16) infinite;
  }

  .radar-cross {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .radar-cross::before,
  .radar-cross::after {
    content: "";
    position: absolute;
    background: var(--blue);
    opacity: 0.45;
  }

  .radar-cross::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
  }

  .radar-cross::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-50%);
  }

  .radar-dot {
    width: 10px;
    height: 10px;
    background: var(--coral);
    border: 2px solid var(--line);
    animation: radar-pulse 1.2s steps(2) infinite;
  }

  @keyframes radar-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes radar-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.6);
      opacity: 0.35;
    }
  }

  .monitor-info {
    flex: 1;
    min-width: 0;
  }

  .monitor-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .badge-lost {
    display: inline-block;
    padding: 3px 8px;
    background: var(--coral);
    color: #fff;
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 2px solid var(--line);
  }

  .badge-code {
    display: inline-block;
    padding: 3px 8px;
    background: var(--off);
    color: var(--ink);
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 2px solid var(--line);
    opacity: 0.85;
  }

  .monitor-route {
    font: 700 13px/1.4 var(--font-mono);
    margin-bottom: 4px;
    color: var(--ink);
    word-break: break-all;
  }

  .route-label {
    opacity: 0.7;
    margin-right: 6px;
  }

  .route-code {
    display: inline-block;
    padding: 2px 6px;
    background: var(--panel);
    border: 2px solid var(--line);
    color: var(--coral);
    font-family: inherit;
  }

  .monitor-desc {
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  /* Cuadro de diálogo RPG */
  .nf-dialog {
    position: relative;
    padding: 18px 22px 20px;
    margin-bottom: 28px;
    background: var(--panel);
    border: 3px solid var(--line);
  }

  .dialog-speaker {
    display: inline-block;
    margin-bottom: 10px;
    padding: 4px 10px;
    background: var(--coral);
    color: #fff;
    border: 3px solid var(--line);
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nf-dialog p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }

  .nf-dialog p :global(strong) {
    font-weight: 700;
    background: var(--sun);
    color: #241b04;
    padding: 0 4px;
  }

  .caret {
    display: inline-block;
    width: 9px;
    height: 16px;
    margin-left: 4px;
    background: var(--ink);
    vertical-align: -2px;
    animation: caret-blink 1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  /* Botones de acción */
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  @media (max-width: 600px) {
    .nf-page {
      padding: 100px 16px 40px;
    }
    .nf-card {
      padding: 24px 18px;
    }
    .nf-monitor {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .nf-actions {
      flex-direction: column;
      width: 100%;
    }
    .nf-actions :global(a) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
