---
import Icon from "@/components/ui/Icon.astro";
---

<button class="to-top" id="toTop" type="button" aria-label="Volver arriba">
  <Icon name="i-up" />
</button>

<script>
  import { initToTop } from "@/scripts/to-top";
  initToTop();
</script>

<style>
  .to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;
    width: 48px;
    height: 48px;
    display: none;
    place-items: center;
    background: var(--panel);
    color: var(--ink);
    border: 4px solid var(--line);
    border-radius: var(--r);
    cursor: pointer;
    box-shadow: 6px 6px 0 0 var(--sh);
  }
  .to-top.show {
    display: grid;
  }
  .to-top :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }
</style>
