---
import Icon from "@/components/ui/Icon.astro";
import type { IconName } from "@/types/icon";
import type { Project } from "@/types/portfolio";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const hasDemo = Boolean(project.demo?.trim());
const hasRepo = Boolean(project.repo?.trim());
const hasRepoApi = Boolean(project.repoApi?.trim());
const portrait = project.image && project.image.height > project.image.width;
const details = [
  { label: "El problema", text: project.caseStudy.problem },
  { label: "Mi aporte", text: project.caseStudy.contribution },
  { label: "El resultado", text: project.caseStudy.outcome },
];
const tagIcons: Partial<Record<string, IconName>> = {
  React: "tech-react",
  "React Native": "tech-react-native",
  Astro: "tech-astro",
  "Tailwind CSS": "tech-tailwind",
  "Node.js": "tech-nodejs",
  TypeScript: "tech-typescript",
  TypeORM: "tech-typeorm",
  MySQL: "tech-mysql",
  Expo: "tech-expo",
  NestJS: "tech-nestjs",
  Prisma: "tech-prisma",
};
---

<div
  class="proj-pane panel"
  id={`pane-${index}`}
  role="tabpanel"
  aria-labelledby={`tab-${index}`}
  tabindex="0"
  data-pane={index}
  hidden={index !== 0}
>
  <div class="pd-record">
    <span>Registro / {String(index + 1).padStart(2, "0")}</span>
    <span class="pd-type">{project.type}</span>
  </div>

  <header class="pd-heading">
    <h3>{project.name}</h3>
    <p>{project.title}</p>
  </header>

  {project.image ? (
    <figure class="pd-preview">
      <div class:list={["pd-stage", { "pd-stage--portrait": portrait }]}>
        <img
          src={project.image.src}
          alt={project.image.alt}
          width={project.image.width}
          height={project.image.height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>{portrait ? "Vista móvil" : "Vista de escritorio"}</span>
        <a
          href={project.image.src}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ampliar captura de ${project.name} (abre en otra pestaña)`}
        >
          Ampliar captura <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  ) : (
    <div class="pd-backend">
      <span class="pd-code" aria-hidden="true">
        &#123; / &#125;
      </span>
      <div>
        <p class="pd-backend-title">API REST · Analítica de salud</p>
        <p>
          Explora las consultas, la lógica de negocio y las pruebas en el
          repositorio.
        </p>
      </div>
    </div>
  )}

  <div class="pd-body">
    <dl class="pd-story">
      {details.map((detail, i) => (
        <div>
          <dt>
            <span aria-hidden="true">0{i + 1}</span>
            {detail.label}
          </dt>
          <dd>{detail.text}</dd>
        </div>
      ))}
    </dl>

    {(hasDemo || hasRepo || hasRepoApi) && (
      <div class="pd-links">
        {hasDemo && (
          <a
            class="pd-link pd-link--primary"
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="i-link" />
            Ver proyecto <span aria-hidden="true">↗</span>
          </a>
        )}
        {hasRepo && (
          <a
            class:list={["pd-link", { "pd-link--primary": !hasDemo }]}
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="pd-code-icon" aria-hidden="true">
              &lt;/&gt;
            </span>
            {hasRepoApi ? "Frontend" : "Ver código"}
          </a>
        )}
        {hasRepoApi && (
          <a
            class="pd-link"
            href={project.repoApi}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="pd-code-icon" aria-hidden="true">
              &lt;/&gt;
            </span>
            API
          </a>
        )}
      </div>
    )}

    <div class="pd-stack">
      <p>Tecnologías</p>
      <ul aria-label={`Tecnologías de ${project.name}`}>
        {project.tags.map((tag) => {
          const icon = tagIcons[tag];
          return (
            <li>
              {icon && <Icon name={icon} />}
              {tag}
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</div>

<style>
  .proj-pane {
    min-width: 0;
    overflow: hidden;
  }
  .pd-record {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px 24px;
    border-bottom: 3px solid var(--line);
    background: var(--panel-2);
    font: 700 10px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pd-type {
    color: var(--ink);
  }
  .pd-heading {
    padding: 24px 28px 20px;
  }
  .pd-heading h3 {
    font: 400 clamp(20px, 2vw, 26px)/1.4 var(--font-pix);
    letter-spacing: -0.04em;
    margin-bottom: 8px;
  }
  .pd-heading p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 60ch;
  }
  .pd-preview {
    margin: 0 28px;
    border: 3px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .pd-stage {
    height: clamp(240px, 27vw, 360px);
    padding: 12px;
    background-color: var(--bg-2);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--ink) 6%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--ink) 6%, transparent) 1px,
        transparent 1px
      );
    background-size: 16px 16px;
  }
  .pd-stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: auto;
  }
  .pd-stage--portrait {
    padding: 16px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 8px 12px;
    border-top: 3px solid var(--line);
    background: var(--panel-2);
    font: 400 10px/1.5 var(--font-mono);
    color: var(--muted);
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pd-backend {
    margin: 0 28px;
    padding: 28px;
    display: flex;
    align-items: center;
    gap: 24px;
    border: 3px dashed var(--off);
    background: var(--panel-2);
    color: var(--muted);
    font-size: 15px;
  }
  .pd-code {
    flex: none;
    color: var(--ink);
    font: 400 24px/1 var(--font-pix);
  }
  .pd-backend-title {
    color: var(--ink);
    font: 700 12px/1.6 var(--font-mono);
    margin-bottom: 8px;
  }
  .pd-body {
    padding: 24px 28px;
  }
  .pd-story {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pd-story dt {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: var(--ink);
    font: 700 10px/1.5 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pd-story dt span {
    color: var(--muted);
    font-weight: 400;
  }
  .pd-story dd {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .pd-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .pd-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px;
    border: 3px solid var(--line);
    border-radius: 4px;
    background: var(--panel-2);
    color: var(--ink);
    font: 700 11px/1.4 var(--font-mono);
    box-shadow: 3px 3px 0 var(--sh);
    transition:
      transform 0.12s steps(2),
      box-shadow 0.12s steps(2);
  }
  .pd-link--primary {
    background: var(--sel);
    color: #04102a;
  }
  .pd-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--sh);
  }
  .pd-link :global(svg) {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  .pd-code-icon {
    font-weight: 400;
  }
  .pd-stack {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 2px dashed var(--off);
  }
  .pd-stack p {
    color: var(--muted);
    font: 400 9px/1.5 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .pd-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    list-style: none;
  }
  .pd-stack li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font: 400 11px/1.5 var(--font-mono);
  }
  .pd-stack :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .proj-pane:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pd-swapping .pd-heading,
    .pd-swapping .pd-preview,
    .pd-swapping .pd-body {
      animation: project-swap 0.16s steps(2);
    }
    @keyframes project-swap {
      from {
        opacity: 0.5;
      }
      to {
        opacity: 1;
      }
    }
  }
  @media (max-width: 640px) {
    .pd-story {
      grid-template-columns: 1fr;
    }
    .pd-heading,
    .pd-body {
      padding: 20px;
    }
    .pd-preview,
    .pd-backend {
      margin-inline: 20px;
    }
    .pd-backend {
      flex-direction: column;
      align-items: flex-start;
    }
    .pd-stage {
      height: auto;
      aspect-ratio: 16 / 9;
      padding: 6px;
    }
    .pd-stage--portrait {
      height: 340px;
      aspect-ratio: auto;
      padding: 12px;
    }
  }
</style>
