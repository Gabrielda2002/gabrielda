---
import { navItems } from "@/data/nav";
---

<nav class="nav" id="nav" aria-label="Secciones">
  <ul>
    {navItems.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    margin-left: auto;
  }
  .nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
  }
  .nav a {
    display: block;
    padding: 12px 14px;
    font: 700 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 4px solid transparent;
    transition:
      color 0.12s steps(2),
      background 0.12s steps(2);
  }
  .nav a:hover {
    color: var(--ink);
    background: var(--panel-2);
  }
  .nav a.is-on {
    color: var(--sel-ink);
    background: var(--sel);
    border-color: var(--line);
  }

  /* Panel móvil: el nav se convierte en un menú desplegable bajo el HUD. */
  @media (max-width: 780px) {
    .nav {
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      background: var(--panel);
      border: 4px solid var(--line);
      border-radius: var(--r);
      margin: 0 16px;
      padding: 8px;
      box-shadow: 8px 8px 0 0 var(--sh);
      display: none;
    }
    .nav.open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      gap: 4px;
    }
    .nav a {
      padding: 14px;
    }
  }
</style>
