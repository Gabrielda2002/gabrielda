---
import Icon from "@/components/ui/Icon.astro";
---

<button
  class="ibtn"
  id="themeBtn"
  type="button"
  aria-label="Cambiar entre día y noche"
  title="Día / Noche"
  aria-pressed="false"
>
  <Icon name="i-day" class="i-day" />
  <Icon name="i-night" class="i-night" />
</button>

<script>
  import { initThemeToggle } from "@/scripts/theme";
  initThemeToggle();
</script>
