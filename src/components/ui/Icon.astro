---
import type { IconName } from "@/types/icon";

interface Props {
  name: IconName;
  viewBox?: string;
  class?: string;
  style?: string;
  preserveAspectRatio?: string;
}

const {
  name,
  viewBox = "0 0 16 16",
  class: className,
  style,
  preserveAspectRatio,
} = Astro.props;
---

<svg
  viewBox={viewBox}
  class={className}
  style={style}
  preserveAspectRatio={preserveAspectRatio}
  aria-hidden="true"
  focusable="false"
>
  <use href={`#${name}`} />
</svg>
