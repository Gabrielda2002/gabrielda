---
interface Props {
  variant?: "primary" | "secondary";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  variant = "primary",
  href,
  type = "button",
  class: className,
} = Astro.props;

const variantClass = variant === "secondary" ? "btn-s" : "btn-p";
---

{href ? (
  <a href={href} class:list={["btn", variantClass, className]}>
    <slot />
  </a>
) : (
  <button type={type} class:list={["btn", variantClass, className]}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    font: 700 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 4px solid var(--line);
    border-radius: var(--r);
    cursor: pointer;
    transition:
      transform 0.1s steps(2),
      box-shadow 0.1s steps(2),
      background 0.24s steps(4),
      color 0.24s steps(4);
  }
  .btn :global(svg) {
    width: 16px;
    height: 16px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }
  .btn-p {
    background: var(--blue);
    color: #06152b;
    box-shadow: 6px 6px 0 0 var(--line);
  }
  .btn-p:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 0 var(--line);
  }
  .btn-p:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 var(--line);
  }
  .btn-s {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 6px 6px 0 0 var(--sh);
  }
  .btn-s:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 0 var(--ink);
  }
  .btn-s:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 var(--sh);
  }

  @media (max-width: 520px) {
    .btn {
      padding: 14px 20px;
      width: 100%;
      justify-content: center;
    }
  }
</style>
