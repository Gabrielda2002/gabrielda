---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import WorldScene from "@/components/hero/WorldScene.astro";
import TitleBlock from "@/components/hero/TitleBlock.astro";
import DialogBox from "@/components/hero/DialogBox.astro";
import PlayerCard from "@/components/hero/PlayerCard.astro";
import { site } from "@/data/site";
---

<section class="hero" id="inicio">
  <WorldScene />

  <div class="wrap hero-in">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="kicker">
          <b>◆</b> {site.kicker}
        </p>

        <TitleBlock />
        <DialogBox />

        <div class="actions">
          <Button variant="primary" href="#proyectos">
            <Icon name="i-play" />
            Ver proyectos
          </Button>
          <Button variant="secondary" href="#contacto">
            <Icon name="i-mail" />
            Contactar
          </Button>
        </div>
      </div>

      <PlayerCard />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 120px 0 64px;
    overflow: hidden;
  }
  .hero-in {
    position: relative;
    z-index: 2;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    background: var(--panel);
    border: 4px solid var(--line);
    border-radius: var(--r);
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 24px;
    box-shadow: 4px 4px 0 0 var(--sh);
  }
  .kicker b {
    color: var(--coral);
  }
  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding-top: 104px;
    }
    .actions {
      flex-direction: column;
    }
  }
</style>
