    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
      style="left: 11%; bottom: 12%; --flower-petal: #ffffff"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
      style="left: 27%; bottom: 12%; --flower-petal: var(--amber)"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
