    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 35%; bottom: 9%"
    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 47%; bottom: 13%"
    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 58%; bottom: 6%"
    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 69%; bottom: 16%"
    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 81%; bottom: 10%"
    />
    <Icon
      name="p-grass"
      viewBox="0 0 5 3"
      class="grass"
      style="left: 92%; bottom: 14%"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
