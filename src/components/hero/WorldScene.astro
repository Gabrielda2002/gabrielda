      style="left: 43%; bottom: 7%; --flower-petal: #ffffff"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
      style="left: 54%; bottom: 10%; --flower-petal: var(--coral)"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
      style="left: 56%; bottom: 7%; --flower-petal: var(--amber)"
    />
    <Icon
      name="p-flower"
