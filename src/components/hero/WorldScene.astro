---
import Icon from "@/components/ui/Icon.astro";
---

<div class="world" aria-hidden="true">
  <div class="w-sky"></div>
  <!-- <div class="w-dith dith"></div> -->
  <div class="w-stars">
    <Icon name="p-stars" viewBox="0 0 240 60" preserveAspectRatio="none" class="field" />
    <Icon name="p-star" viewBox="0 0 1 1" class="star" style="left: 14%; top: 30%; animation-delay: 0s" />
    <Icon name="p-sparkle" viewBox="0 0 5 5" class="sparkle" style="left: 33%; top: 12%; animation-delay: 1.4s; animation-duration: 5s" />
    <Icon name="p-star" viewBox="0 0 1 1" class="star" style="left: 52%; top: 40%; animation-delay: 2.2s; animation-duration: 3.6s" />
    <Icon name="p-star" viewBox="0 0 1 1" class="star" style="left: 67%; top: 18%; animation-delay: 0.7s; animation-duration: 4.4s" />
    <Icon name="p-sparkle" viewBox="0 0 5 5" class="sparkle" style="left: 82%; top: 44%; animation-delay: 3s; animation-duration: 5.5s" />
    <Icon name="p-star" viewBox="0 0 1 1" class="star" style="left: 24%; top: 55%; animation-delay: 1.9s; animation-duration: 4.8s" />
  </div>
  <div class="w-sun">
    <Icon name="p-sun" class="sun" />
    <Icon name="p-moon" class="moon" />
  </div>
  <div class="w-cloud c1">
    <Icon name="p-cloud-2" viewBox="0 0 20 10" />
  </div>
  <div class="w-cloud c2">
    <Icon name="p-cloud" viewBox="0 0 16 10" />
  </div>
  <div class="w-cloud c3">
    <Icon name="p-cloud" viewBox="0 0 20 10" />
  </div>
  <div class="w-ridge">
    <Icon name="p-ridge-back" viewBox="0 0 240 33" preserveAspectRatio="none" />
  </div>
  <div class="w-ridge w-ridge-front">
    <Icon name="p-ridge-front" viewBox="0 0 240 14" preserveAspectRatio="none" />
  </div>
  <div class="w-town">
    <Icon name="p-town" viewBox="0 0 200 20" preserveAspectRatio="none" />
  </div>
  <div class="w-smoke smoke-1">
    <Icon name="p-smoke" class="puff" />
    <Icon name="p-smoke" class="puff" />
    <Icon name="p-smoke" class="puff" />
  </div>
  <div class="w-smoke smoke-2">
    <Icon name="p-smoke" class="puff" />
    <Icon name="p-smoke" class="puff" />
    <Icon name="p-smoke" class="puff" />
  </div>
  <!-- <div class="w-ground-d dith"></div> -->
  <div class="w-ground"></div>
  <div class="w-tree t1">
    <Icon name="p-tree" viewBox="0 0 14 20" />
  </div>
  <div class="w-tree t2">
    <Icon name="p-tree" viewBox="0 0 14 20" />
  </div>
  <div class="w-tree t3">
    <Icon name="p-tree" viewBox="0 0 14 20" />
  </div>
  <div class="w-fireflies">
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 10%; top: 66%; animation: wander-a 11s steps(12) infinite 0s, firefly-glow 2.3s steps(2, jump-none) infinite 0.4s" />
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 17%; top: 57%; animation: wander-b 13s steps(12) infinite 0s, firefly-glow 1.9s steps(2, jump-none) infinite 1.1s" />
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 45%; top: 70%; animation: wander-c 9.5s steps(12) infinite 0s, firefly-glow 2.6s steps(2, jump-none) infinite 0s" />
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 71%; top: 61%; animation: wander-a 12s steps(12) infinite 0s, firefly-glow 2.1s steps(2, jump-none) infinite 1.6s" />
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 80%; top: 71%; animation: wander-b 10.5s steps(12) infinite 0s, firefly-glow 2.8s steps(2, jump-none) infinite 0.8s" />
    <Icon name="p-firefly" viewBox="0 0 1 1" class="firefly" style="left: 91%; top: 64%; animation: wander-c 12.5s steps(12) infinite 0s, firefly-glow 2s steps(2, jump-none) infinite 1.3s" />
  </div>
</div>

<style>
  .world {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Suavizado de silueta: 0 = borde pixel duro; prueba 0.6 (sutil) o 1.2 (marcado). */
    --px-soft: 0;
  }
  .world :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: var(--px-soft);
    stroke-linejoin: round;
    shape-rendering: auto;
  }
  .w-stars {
    position: absolute;
    left: 0;
    right: 0;
    top: 10%;
    height: 46%;
    display: none;
    color: #eaf1ff;
  }
  :global([data-theme="night"]) .w-stars {
    display: block;
  }
  .w-stars :global(.star) {
    position: absolute;
    width: 5px;
    height: 5px;
    animation: twinkle 4s steps(2, jump-none) infinite;
  }
  .w-stars :global(.sparkle) {
    position: absolute;
    width: 16px;
    height: 16px;
    animation: twinkle 5s steps(2, jump-none) infinite;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-stars :global(.star),
    .w-stars :global(.sparkle) {
      animation: none;
    }
  }
  .w-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--w-sky-1) 0 28%,
      var(--w-sky-2) 28% 62%,
      var(--w-sky-3) 62% 100%
    );
  }
  .w-dith {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    height: 40%;
    opacity: 0.5;
  }
  .w-sun {
    position: absolute;
    top: 11%;
    right: 12%;
    width: 128px;
    height: 128px;
    --sun-line: #0e1a2c;
    --sun-hi: #fff3b0;
    --sun-base: #ffd34e;
    --sun-shade: #f5a623;
    --sun-deep: #d97b1a;
    --moon-line: #040a24;
    --moon-hi: #fffdf0;
    --moon-base: #e6dfae;
    --moon-shade: #c7bc86;
  }
  .w-sun :global(.moon) {
    display: none;
  }
  :global([data-theme="night"]) .w-sun :global(.sun) {
    display: none;
  }
  :global([data-theme="night"]) .w-sun :global(.moon) {
    display: block;
  }
  .w-cloud {
    position: absolute;
    opacity: 1;
    --cloud-line: #0e1a2c;
    --cloud-hi: #ffffff;
    --cloud-base: #e7f0f8;
    --cloud-shade: #c9d8e6;
    --cloud-deep: #a3b7cc;
  }
  :global([data-theme="night"]) .w-cloud {
    opacity: 0.9;
    --cloud-line: #040a24;
    --cloud-hi: #eaf1ff;
    --cloud-base: #c9d6ff;
    --cloud-shade: #98a4cf;
    --cloud-deep: #6f81bc;
  }
  .c1 {
    top: 14%;
    left: 8%;
    width: 400px;
    height: 120px;
    animation: drift 42s steps(24) infinite;
  }
  .c2 {
    top: 25%;
    left: 42%;
    width: 112px;
    height: 56px;
    animation: drift 58s steps(28) infinite reverse;
  }
  .c3 {
    top: 9%;
    left: 66%;
    width: 88px;
    height: 44px;
    animation: drift 50s steps(22) infinite;
  }
  @keyframes drift {
    from {
      transform: translateX(-24px);
    }
    to {
      transform: translateX(24px);
    }
  }

  .w-ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    height: 32%;
    --ridge-line: #0e1a2c;
    --ridge-base: var(--w-hill-a);
    --ridge-snow: #f2f7fc;
    /* Grosor del contorno de las cordilleras: prueba 1 / 0.75 / 0.5. */
    --ridge-line-w: 0.75;
  }
  .w-ridge-front {
    height: 26%;
    --ridge-base: var(--w-hill-b);
  }
  :global([data-theme="night"]) .w-ridge {
    --ridge-line: #040a24;
    --ridge-snow: #b9c6ea;
  }
  .w-town {
    position: absolute;
    bottom: 21%;
    left: 0;
    right: 0;
    height: 12%;
    color: var(--w-town);
    opacity: 0.85;
    --town-light: transparent;
  }

  :global([data-theme="night"]) .w-town {
    --town-light: var(--amber);
  }
  .w-smoke {
    position: absolute;
    bottom: 31.2%;
    width: 22px;
    height: 140px;
    color: #ffffff;
  }
  .smoke-1 {
    left: 30.4%;
  }
  .smoke-2 {
    left: 55.4%;
  }
  .w-smoke :global(.puff) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 22px;
    height: 22px;
    opacity: 0;
    animation: smoke-rise 6s steps(9) infinite;
  }
  .w-smoke :global(.puff:nth-child(2)) {
    animation-delay: 2s;
  }
  .w-smoke :global(.puff:nth-child(3)) {
    animation-delay: 4s;
  }
  :global([data-theme="night"]) .w-smoke {
    color: #c9d6ff;
    opacity: 0.55;
  }
  @keyframes smoke-rise {
    from {
      transform: translate(0, 0) scale(0.6);
      opacity: 0;
    }
    15% {
      opacity: 0.85;
    }
    to {
      transform: translate(-16px, -110px) scale(1.25);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-smoke :global(.puff) {
      animation: none;
    }
  }
  .w-fireflies {
    position: absolute;
    inset: 0;
    display: none;
    color: #ffe886;
  }
  :global([data-theme="night"]) .w-fireflies {
    display: block;
  }
  .w-fireflies :global(.firefly) {
    position: absolute;
    width: 6px;
    height: 6px;
    filter: drop-shadow(0 0 4px rgba(255, 232, 134, 0.9))
      drop-shadow(0 0 11px rgba(255, 214, 90, 0.4));
  }
  @keyframes wander-a {
    0% {
      transform: translate(0, 0);
    }
    30% {
      transform: translate(26px, -20px);
    }
    60% {
      transform: translate(48px, 4px);
    }
    80% {
      transform: translate(18px, 20px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes wander-b {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-22px, -14px);
    }
    55% {
      transform: translate(-40px, 10px);
    }
    80% {
      transform: translate(-12px, 18px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes wander-c {
    0% {
      transform: translate(0, 0);
    }
    35% {
      transform: translate(14px, -24px);
    }
    65% {
      transform: translate(-10px, -8px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes firefly-glow {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-fireflies :global(.firefly) {
      animation: none !important;
    }
  }
  .w-ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 21%;
    background: var(--w-grass-1);
    border-top: 4px solid var(--line);
  }
  .w-ground-d {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    height: 40px;
  }
  .w-tree {
    position: absolute;
    bottom: 20%;
    color: var(--w-grass-2);
  }
  .t1 {
    left: 6%;
    width: 56px;
    height: 80px;
  }
  .t2 {
    left: 78%;
    width: 72px;
    height: 100px;
  }
  .t3 {
    left: 88%;
    width: 48px;
    height: 68px;
  }

  @media (max-width: 780px) {
    .w-sun {
      width: 88px;
      height: 88px;
    }
    .c1,
    .c2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w-cloud {
      animation: none;
    }
  }
</style>
