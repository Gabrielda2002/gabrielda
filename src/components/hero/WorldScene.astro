      class="flower"
      style="left: 75%; bottom: 13%; --flower-petal: #ffffff"
    />
    <Icon
      name="p-flower"
      viewBox="0 0 3 5"
      class="flower"
      style="left: 88%; bottom: 6%; --flower-petal: var(--coral)"
    />
    <Icon
      name="p-flower-2"
      viewBox="0 0 9 12"
      class="flower-lg"
      style="left: 20%; bottom: 8%"
    />
    <Icon
      name="p-flower-2"
      viewBox="0 0 9 12"
      class="flower-lg"
      style="left: 37%; bottom: 11%"
    />
    <Icon
      name="p-flower-2"
      viewBox="0 0 9 12"
      class="flower-lg"
      style="left: 63%; bottom: 7%"
    />
  </div>
  <div class="w-tree t1">
    <Icon name="p-tree" viewBox="0 0 14 20" />
  </div>
  <div class="w-tree t2">
    <Icon name="p-tree" viewBox="0 0 14 20" />
  </div>
  <div class="w-tree t3">
    <Icon name="p-tree-2" viewBox="0 0 16 24" />
  </div>
  <div class="w-tree bush1">
    <Icon name="p-bush" viewBox="0 0 10 4" />
  </div>
  <div class="w-tree bush2">
    <Icon name="p-bush" viewBox="0 0 10 4" />
  </div>
  <div class="w-tree bush3">
    <Icon name="p-bush" viewBox="0 0 10 4" />
  </div>
  <div class="w-fireflies">
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 10%; top: 66%; animation: wander-a 11s steps(12) infinite 0s, firefly-glow 2.3s steps(2, jump-none) infinite 0.4s"
    />
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 17%; top: 57%; animation: wander-b 13s steps(12) infinite 0s, firefly-glow 1.9s steps(2, jump-none) infinite 1.1s"
    />
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 45%; top: 70%; animation: wander-c 9.5s steps(12) infinite 0s, firefly-glow 2.6s steps(2, jump-none) infinite 0s"
    />
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 71%; top: 61%; animation: wander-a 12s steps(12) infinite 0s, firefly-glow 2.1s steps(2, jump-none) infinite 1.6s"
    />
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 80%; top: 71%; animation: wander-b 10.5s steps(12) infinite 0s, firefly-glow 2.8s steps(2, jump-none) infinite 0.8s"
    />
    <Icon
      name="p-firefly"
      viewBox="0 0 1 1"
      class="firefly"
      style="left: 91%; top: 64%; animation: wander-c 12.5s steps(12) infinite 0s, firefly-glow 2s steps(2, jump-none) infinite 1.3s"
    />
  </div>
</div>

<style>
  .world {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    /* Suavizado de silueta: 0 = borde pixel duro; prueba 0.6 (sutil) o 1.2 (marcado). */
    --px-soft: 0;
  }
  .world :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: var(--px-soft);
    stroke-linejoin: round;
    shape-rendering: auto;
  }
  /* Parallax vertical: cada capa se retrasa un poco con el scroll del hero.
     Cuanto más lejana la capa, mayor el factor. */
  .w-sun {
    transform: translateY(calc(var(--parallax, 0) * 0.35px));
  }
  .w-stars {
    transform: translateY(calc(var(--parallax, 0) * 0.35px));
  }
  .w-ridge {
    transform: translateY(calc(var(--parallax, 0) * 0.16px));
  }
  .w-ridge-far {
    transform: translateY(calc(var(--parallax, 0) * 0.22px));
  }
  .w-ridge-front {
    transform: translateY(calc(var(--parallax, 0) * 0.1px));
  }
  .w-town {
    transform: translateY(calc(var(--parallax, 0) * 0.05px));
  }
  .w-smoke {
    transform: translateY(calc(var(--parallax, 0) * 0.05px));
  }
  @media (prefers-reduced-motion: reduce) {
    .w-sun,
    .w-stars,
    .w-ridge,
    .w-ridge-far,
    .w-ridge-front,
    .w-town,
    .w-smoke {
      transform: none;
    }
  }
  .w-stars {
    position: absolute;
    left: 0;
    right: 0;
    top: 10%;
    height: 46%;
    display: none;
    color: #eaf1ff;
  }
  :global([data-theme="night"]) .w-stars {
    display: block;
  }
  .w-stars :global(.star) {
    position: absolute;
    width: 5px;
    height: 5px;
    animation: twinkle 4s steps(2, jump-none) infinite;
  }
  .w-stars :global(.sparkle) {
    position: absolute;
    width: 16px;
    height: 16px;
    animation: twinkle 5s steps(2, jump-none) infinite;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-stars :global(.star),
    .w-stars :global(.sparkle) {
      animation: none;
    }
  }
  .w-birds {
    position: absolute;
    inset: 0;
    color: var(--ink);
  }
  :global([data-theme="night"]) .w-birds {
    display: none;
  }
  .bird {
    position: absolute;
    animation: fly 55s linear infinite;
  }
  .bird :global(svg) {
    width: 20px;
    height: 12px;
    animation: flap 0.9s steps(2, jump-none) infinite;
  }
  .b1 {
    top: 16%;
  }
  .b2 {
    top: 24%;
    animation-duration: 70s;
    animation-delay: -25s;
  }
  .b2 :global(svg) {
    width: 14px;
    height: 8px;
    animation-duration: 1.1s;
  }
  .b3 {
    top: 11%;
    animation-duration: 48s;
    animation-delay: -40s;
  }
  .b3 :global(svg) {
    width: 16px;
    height: 10px;
    animation-duration: 0.8s;
  }
  @keyframes fly {
    from {
      transform: translate(-80px, 0);
    }
    50% {
      transform: translate(50vw, -16px);
    }
    to {
      transform: translate(105vw, 0);
    }
  }
  @keyframes flap {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.55);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bird,
    .bird :global(svg) {
      animation: none;
    }
  }
  .w-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--w-sky-1) 0 28%,
      var(--w-sky-2) 28% 62%,
      var(--w-sky-3) 62% 100%
    );
  }
  .w-dith {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    height: 40%;
    opacity: 0.5;
  }
  .w-sun {
    position: absolute;
    top: 11%;
    right: 12%;
    width: 128px;
    height: 128px;
    --sun-line: #0e1a2c;
    --sun-hi: #fff3b0;
    --sun-base: #ffd34e;
    --sun-shade: #f5a623;
    --sun-deep: #d97b1a;
    --moon-line: #040a24;
    --moon-hi: #fffdf0;
    --moon-base: #e6dfae;
    --moon-shade: #c7bc86;
  }
  .w-sun :global(.moon) {
    display: none;
  }
  :global([data-theme="night"]) .w-sun :global(.sun) {
    display: none;
  }
  :global([data-theme="night"]) .w-sun :global(.moon) {
    display: block;
  }
  .w-cloud {
    position: absolute;
    opacity: 1;
    --cloud-line: #0e1a2c;
    --cloud-hi: #ffffff;
    --cloud-base: #e7f0f8;
    --cloud-shade: #c9d8e6;
    --cloud-deep: #a3b7cc;
  }
  :global([data-theme="night"]) .w-cloud {
    opacity: 0.9;
    --cloud-line: #040a24;
    --cloud-hi: #eaf1ff;
    --cloud-base: #c9d6ff;
    --cloud-shade: #98a4cf;
    --cloud-deep: #6f81bc;
  }
  .c1 {
    top: 14%;
    left: 8%;
    width: 400px;
    height: 120px;
    animation: drift 42s steps(24) infinite;
  }
  .c2 {
    top: 25%;
    left: 42%;
    width: 112px;
    height: 56px;
    animation: drift 58s steps(28) infinite reverse;
  }
  .c3 {
    top: 9%;
    left: 66%;
    width: 88px;
    height: 44px;
    animation: drift 50s steps(22) infinite;
  }
  @keyframes drift {
    from {
      transform: translateX(-24px);
    }
    to {
      transform: translateX(24px);
    }
  }

  .w-ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    height: 32%;
    --ridge-line: #0e1a2c;
    --ridge-base: var(--w-hill-a);
    --ridge-snow: #f2f7fc;
    /* Grosor del contorno de las cordilleras: prueba 1 / 0.75 / 0.5. */
    --ridge-line-w: 0.75;
  }
  .w-ridge-front {
    height: 26%;
    --ridge-base: var(--w-hill-b);
  }
  .w-ridge-far {
    height: 38%;
    --ridge-base: #aede8c;
  }
  :global([data-theme="night"]) .w-ridge-far {
    --ridge-base: #2a5a5e;
  }
  :global([data-theme="night"]) .w-ridge {
    --ridge-line: #040a24;
    --ridge-snow: #b9c6ea;
  }
  .w-town {
    position: absolute;
    bottom: 21%;
    left: 0;
    right: 0;
    height: 12%;
    color: var(--w-town);
    opacity: 0.85;
    --town-light: transparent;
  }

  :global([data-theme="night"]) .w-town {
    --town-light: var(--amber);
  }
  .w-smoke {
    position: absolute;
    bottom: 31.2%;
    width: 22px;
    height: 140px;
    color: #ffffff;
  }
  .smoke-1 {
    left: 30.4%;
  }
  .smoke-2 {
    left: 55.4%;
  }
  .w-smoke :global(.puff) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 22px;
    height: 22px;
    opacity: 0;
    animation: smoke-rise 6s steps(9) infinite;
  }
  .w-smoke :global(.puff:nth-child(2)) {
    animation-delay: 2s;
  }
  .w-smoke :global(.puff:nth-child(3)) {
    animation-delay: 4s;
  }
  :global([data-theme="night"]) .w-smoke {
    color: #c9d6ff;
    opacity: 0.55;
  }
  @keyframes smoke-rise {
    from {
      transform: translate(0, 0) scale(0.6);
      opacity: 0;
    }
    15% {
      opacity: 0.85;
    }
    to {
      transform: translate(-16px, -110px) scale(1.25);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-smoke :global(.puff) {
      animation: none;
    }
  }
  .w-fireflies {
    position: absolute;
    inset: 0;
    display: none;
    color: #ffe886;
  }
  :global([data-theme="night"]) .w-fireflies {
    display: block;
  }
  .w-fireflies :global(.firefly) {
    position: absolute;
    width: 6px;
    height: 6px;
    filter: drop-shadow(0 0 4px rgba(255, 232, 134, 0.9))
      drop-shadow(0 0 11px rgba(255, 214, 90, 0.4));
  }
  @keyframes wander-a {
    0% {
      transform: translate(0, 0);
    }
    30% {
      transform: translate(26px, -20px);
    }
    60% {
      transform: translate(48px, 4px);
    }
    80% {
      transform: translate(18px, 20px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes wander-b {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-22px, -14px);
    }
    55% {
      transform: translate(-40px, 10px);
    }
    80% {
      transform: translate(-12px, 18px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes wander-c {
    0% {
      transform: translate(0, 0);
    }
    35% {
      transform: translate(14px, -24px);
    }
    65% {
      transform: translate(-10px, -8px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes firefly-glow {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-fireflies :global(.firefly) {
      animation: none !important;
    }
  }
  .w-meadow {
    position: absolute;
    inset: 0;
  }
  :global([data-theme="night"]) .w-meadow {
    opacity: 0.5;
  }
  .w-meadow :global(.grass) {
    position: absolute;
    width: 22px;
    height: 13px;
    color: var(--w-grass-2);
  }
  .w-meadow :global(.flower) {
    position: absolute;
    width: 14px;
    height: 23px;
  }
  .w-meadow :global(.flower-lg) {
    position: absolute;
    width: 30px;
    height: 40px;
  }
  .w-ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 21%;
    background: var(--w-grass-1);
    border-top: 4px solid var(--line);
  }
  .w-ground-d {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    height: 40px;
  }
  .w-tree {
    position: absolute;
    bottom: 20%;
    color: var(--w-grass-2);
    --tree-line: #0e1a2c;
  }
  :global([data-theme="night"]) .w-tree {
    --tree-line: #040a24;
  }
  .t1 {
    left: 6%;
    width: 56px;
    height: 80px;
  }
  .t2 {
    left: 78%;
    width: 72px;
    height: 100px;
  }
  .t3 {
    left: 88%;
    width: 48px;
    height: 72px;
  }
  .bush1 {
    left: 15%;
    width: 28px;
    height: 11px;
  }
  .bush2 {
    left: 71%;
    width: 34px;
    height: 14px;
  }
  .bush3 {
    left: 95%;
    width: 24px;
    height: 10px;
  }

  @media (max-width: 780px) {
    .w-sun {
      width: 88px;
      height: 88px;
    }
    .c1,
    .c2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w-cloud {
      animation: none;
    }
  }
</style>
