---
import Icon from "@/components/ui/Icon.astro";
---

<div class="world" aria-hidden="true">
  <div class="w-sky"></div>
  <!-- <div class="w-dith dith"></div> -->
  <div class="w-stars">
    <Icon
      name="p-stars"
      viewBox="0 0 240 60"
      preserveAspectRatio="none"
      class="field"
    />
    <Icon
      name="p-star"
      viewBox="0 0 1 1"
