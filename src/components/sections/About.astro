---
import SectionHead from "@/components/ui/SectionHead.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/data/site";
import { technologyBadges } from "@/data/skills";
---


<section class="sec" id="sobre-mi">
  <div class="wrap">
    <SectionHead tag="01 · Ficha" title="Sobre mí" number="01" />

    <div class="about-grid">
      <div class="about-copy panel reveal">
        {site.bio.map((paragraph) => (
          <p set:html={paragraph} />
        ))}
      </div>

      <div>
        <!-- <div class="quote panel reveal">
          <blockquote>{site.quote}</blockquote>
          <cite>{site.quoteCitation}</cite>
        </div> -->

        <div class="badges reveal" aria-label="Tecnologías">
          {technologyBadges.map((tech) => (
            <span class="badge">
              <Icon name={tech.icon} class="b-ico" />
              {tech.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .about-copy {
    padding: 32px;
  }
  .about-copy p {
    color: var(--muted);
    margin-bottom: 16px;
    font-size: 16px;
    line-height: 1.75;
  }
  .about-copy p:last-child {
    margin-bottom: 0;
  }
  .about-copy :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }
  .quote {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .quote blockquote {
    font: 700 19px/1.5 var(--font-body);
  }
  .quote cite {
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    font-style: normal;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--panel);
    border: 4px solid var(--line);
    border-radius: var(--r);
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 0 var(--sh);
    transition:
      transform 0.1s steps(2),
      box-shadow 0.1s steps(2);
  }
  .badge:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--sh);
  }
  .badge :global(.b-ico) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    shape-rendering: crispEdges;
  }


  @media (max-width: 1000px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
