---
import SectionHead from "@/components/ui/SectionHead.astro";
import ProjectDetail from "@/components/projects/ProjectDetail.astro";
import { projects } from "@/data/projects";
---

<section class="sec" id="proyectos">
  <div class="wrap">
    <SectionHead tag="03 · Registro" title="Proyectos" number="03" />

    <div class="proj">
      <div class="proj-catalog panel reveal">
        <div class="catalog-head" aria-hidden="true">
          <span>Catálogo</span>
          <span>{String(projects.length).padStart(2, "0")} proyectos</span>
        </div>
        <div
          class="proj-list"
          role="tablist"
          aria-label="Proyectos"
          aria-orientation="vertical"
        >
          {projects.map((project, i) => (
            <button
              class="pj"
              type="button"
              role="tab"
              id={`tab-${i}`}
              aria-controls={`pane-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-i={i}
              tabindex={i === 0 ? "0" : "-1"}
            >
              <span class="arw" aria-hidden="true">
                ▶
              </span>
              <span class="num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="pj-label">
                <span class="nm">{project.name}</span>
                <span class="st">{project.type}</span>
              </span>
            </button>
          ))}
        </div>
        <p class="catalog-hint" aria-hidden="true">
          ↑ ↓ <span>Cambiar proyecto</span>
        </p>
      </div>

      <div class="proj-panels reveal">
        {projects.map((project, index) => (
          <ProjectDetail project={project} index={index} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjects } from "@/scripts/projects";

  initProjects();
  document.addEventListener("astro:page-load", initProjects);
</script>

<style>
  .proj {
    display: grid;
    grid-template-columns: minmax(260px, 0.38fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .proj-catalog {
    position: sticky;
    top: 100px;
    min-width: 0;
  }
  .catalog-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border-bottom: 3px solid var(--line);
    font: 700 10px/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .catalog-head span:last-child {
    font-weight: 400;
    color: var(--muted);
  }
  .proj-list {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pj {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    text-align: left;
    padding: 16px 10px;
    background: transparent;
    border: 3px solid transparent;
    border-radius: 4px;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition:
      background 0.12s steps(2),
      color 0.12s steps(2);
  }
  .arw {
    font-size: 10px;
    opacity: 0;
  }
  .num {
    font: 400 11px/1 var(--font-pix);
    color: var(--muted);
  }
  .pj-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .nm {
    font: 700 16px/1.3 var(--font-body);
  }
  .st {
    font: 400 9px/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pj:hover {
    background: var(--panel-2);
  }
  .pj[aria-selected="true"] {
    background: var(--sel);
    color: #04102a;
    border-color: var(--line);
  }
  .pj[aria-selected="true"] .arw {
    opacity: 1;
  }
  .pj[aria-selected="true"] .num,
  .pj[aria-selected="true"] .st {
    color: inherit;
  }
  .pj:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 1px;
  }
  .catalog-hint {
    padding: 12px 16px;
    border-top: 2px dashed var(--off);
    color: var(--muted);
    font: 400 11px/1.5 var(--font-mono);
  }
  .catalog-hint span {
    margin-left: 8px;
    font-size: 10px;
  }
  .proj-panels {
    min-width: 0;
  }
  @media (max-width: 1000px) {
    .proj {
      grid-template-columns: minmax(0, 1fr);
    }
    .proj-catalog {
      position: static;
    }
  }
</style>
