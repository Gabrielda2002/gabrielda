---
import SectionHead from "@/components/ui/SectionHead.astro";
import Icon from "@/components/ui/Icon.astro";
import { projects } from "@/data/projects";
import type { IconName } from "@/types/icon";

const TAG_ICON_MAP: Record<string, IconName> = {
  typescript: "tech-typescript",
  ts: "tech-typescript",
  react: "tech-react",
  "react native": "tech-react-native",
  astro: "tech-astro",
  tailwind: "tech-tailwind",
  "tailwind css": "tech-tailwind",
  nativewind: "tech-nativewind",
  "node.js": "tech-nodejs",
  node: "tech-nodejs",
  express: "tech-express",
  nestjs: "tech-nestjs",
  "nest.js": "tech-nestjs",
  mysql: "tech-mysql",
  postgresql: "tech-postgresql",
  postgres: "tech-postgresql",
  typeorm: "tech-typeorm",
  prisma: "tech-prisma",
  "prisma orm": "tech-prisma",
  expo: "tech-expo",
};
---

<section class="sec" id="proyectos">
  <div class="wrap">
    <SectionHead tag="03 · Registro" title="Proyectos" number="03" />

    <div class="proj">
      <div
        class="proj-list panel reveal"
        role="tablist"
        aria-label="Proyectos"
        aria-orientation="vertical"
      >
        {projects.map((project, i) => (
          <button
            class="pj"
            type="button"
            role="tab"
            id={`tab-${i}`}
            aria-controls={`pane-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-i={i}
            tabindex={i === 0 ? "0" : "-1"}
          >
            <span class="arw" aria-hidden="true">
              ▶
            </span>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="nm">{project.name}</span>
            <span class="st">{project.type}</span>
          </button>
        ))}
      </div>

      <div class="proj-panels reveal">
        {projects.map((project, i) => {
          const hasRepo = Boolean(project.repo && project.repo.trim() !== "");
          const hasRepoApi = Boolean(project.repoApi && project.repoApi.trim() !== "");
          const hasDemo = Boolean(project.demo && project.demo.trim() !== "");
          const hasLinks = hasRepo || hasRepoApi || hasDemo;
          const hasImage = Boolean(project.image && project.image.trim() !== "");

          return (
            <div
              class="proj-pane panel"
              id={`pane-${i}`}
              role="tabpanel"
              aria-labelledby={`tab-${i}`}
              tabindex="0"
              data-pane={i}
              hidden={i !== 0}
            >
              <div class="pd-stage">
                {hasImage ? (
                  <img
                    class="pd-img"
                    src={project.image}
                    alt={`Captura de ${project.name}`}
                    loading="lazy"
                  />
                ) : (
                  <div class="pd-empty" aria-hidden="true">
                    <div class="radar-box">
                      <span class="radar-cross" />
                      <span class="radar-dot" />
                    </div>
                    <span class="radar-label">DATOS REGISTRADOS · SIN IMAGEN</span>
                  </div>
                )}
                
                <span class="cap">
                  {`REGISTRO #${String(i + 1).padStart(2, "0")} · ${project.type}`}
                </span>
              </div>

              <div class="pd-body">
                <div class="pd-tags">
                  {project.tags.map((tag) => {
                    const iconName = TAG_ICON_MAP[tag.toLowerCase().trim()];
                    return (
                      <span>
                        {iconName && <Icon name={iconName} class="tag-ico" />}
                        {tag}
                      </span>
                    );
                  })}
                </div>

                <h3 class="pd-title">{project.title}</h3>
                <p class="pd-desc">{project.description}</p>

                {hasLinks && (
                  <div class="pd-links">
                    {hasRepo && (
                      <a
                        class="chip-link"
                        href={project.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="i-repo" />
                        <span>{hasRepoApi ? "Frontend" : "Código"}</span>
                      </a>
                    )}
                    {hasRepoApi && (
                      <a
                        class="chip-link"
                        href={project.repoApi}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="i-repo" />
                        <span>API</span>
                      </a>
                    )}
                    {hasDemo && (
                      <a
                        class="chip-link"
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name="i-link" />
                        <span>Demo</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjects } from "@/scripts/projects";

  initProjects();
  document.addEventListener("astro:page-load", initProjects);
</script>

<style>
  .proj {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 24px;
    align-items: start;
  }
  .proj-list {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pj {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    padding: 16px 12px;
    background: transparent;
    border: 4px solid transparent;
    border-radius: 4px;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition:
      background 0.12s steps(2),
      color 0.12s steps(2);
  }
  .pj .arw {
    color: var(--sel);
    font-size: 12px;
    opacity: 0;
  }
  .pj .num {
    font: 900 12px/1 var(--font-pix);
    color: var(--muted);
  }
  .pj .nm {
    flex: 1;
    font: 700 15px/1.2 var(--font-body);
  }
  .pj .st {
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pj:hover {
    background: var(--panel-2);
  }
  .pj[aria-selected="true"] {
    background: var(--sel);
    color: var(--sel-ink);
    border-color: var(--line);
  }
  .pj[aria-selected="true"] .arw {
    opacity: 1;
    color: var(--sel-ink);
  }
  .pj[aria-selected="true"] .num,
  .pj[aria-selected="true"] .st {
    color: var(--sel-ink);
  }
  .pj:focus-visible {
    outline: 4px solid var(--amber);
    outline-offset: 2px;
  }

  .proj-pane {
    padding: 24px;
  }
  .pd-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--panel-2);
    border: 4px solid var(--line);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .pd-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pd-img[hidden] {
    display: none;
  }
  .pd-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(14, 26, 44, 0.08) 0 2px,
      transparent 2px 4px
    );
    background-color: var(--panel-2);
  }
  .pd-empty[hidden] {
    display: none;
  }
  .radar-box {
    width: 64px;
    height: 64px;
    border: 2px dashed var(--blue);
    border-radius: 50%;
    position: relative;
    display: grid;
    place-items: center;
    animation: radar-spin 10s steps(16) infinite;
  }
  .radar-cross {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  .radar-cross::before,
  .radar-cross::after {
    content: "";
    position: absolute;
    background: var(--blue);
    opacity: 0.4;
  }
  .radar-cross::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
  }
  .radar-cross::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-50%);
  }
  .radar-dot {
    width: 10px;
    height: 10px;
    background: var(--coral);
    border: 2px solid var(--line);
    animation: radar-pulse 1.4s steps(2) infinite;
  }
  @keyframes radar-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes radar-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.6);
      opacity: 0.4;
    }
  }
  .radar-label {
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .pd-stage .cap {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 4px 8px;
    background: var(--ink);
    color: var(--bg);
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 0 var(--sh);
  }
  .pd-body {
    padding-top: 20px;
  }
  .pd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .pd-tags :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 3px solid var(--line);
    border-radius: 4px;
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--panel-2);
    box-shadow: 2px 2px 0 0 var(--sh);
  }
  .pd-tags :global(.tag-ico) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    shape-rendering: crispEdges;
  }
  .proj-pane.pd-swapping .pd-stage,
  .proj-pane.pd-swapping .pd-body {
    animation: pokedex-swap 0.14s steps(2);
  }
  @keyframes pokedex-swap {
    0% {
      opacity: 0.3;
      filter: contrast(1.5) brightness(1.2);
    }
    100% {
      opacity: 1;
      filter: none;
    }
  }
  .pd-title {

    font: 900 24px/1.1 var(--font-pix);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .pd-desc {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .pd-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pd-links[hidden],
  .chip-link[hidden] {
    display: none;
  }
  .chip-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 4px solid var(--line);
    border-radius: var(--r);
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--panel);
    transition:
      transform 0.1s steps(2),
      background 0.12s steps(2),
      color 0.12s steps(2);
  }
  .chip-link:hover {
    background: var(--ink);
    color: var(--bg);
    transform: translate(-2px, -2px);
  }
  .chip-link :global(svg) {
    width: 14px;
    height: 14px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  @media (max-width: 1000px) {
    .proj {
      grid-template-columns: 1fr;
    }
  }
</style>
