---
import SectionHead from "@/components/ui/SectionHead.astro";
import Icon from "@/components/ui/Icon.astro";
import ContactForm from "@/components/sections/ContactForm.astro";
import { site } from "@/data/site";
import { socialLinks } from "@/data/social";
---

<section class="sec" id="contacto">
  <div class="wrap">
    <SectionHead tag="04 · Enlace" title="Trabajemos juntos" number="04" />

    <div class="contact">
      <div class="ch-panel panel reveal">
        <p>{site.contactIntro}</p>

        <div class="channels">
          {socialLinks.map((s) => (
            <a class="ch" href={s.href} target="_blank" rel="noopener noreferrer">
              <span class="ico">
                <Icon name={s.icon} />
              </span>
              <span>
                <span class="lb">{s.label}</span>
                <span class="vl">{s.value}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 24px;
    align-items: start;
  }
  .ch-panel {
    padding: 24px;
  }
  .ch-panel > p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 24px;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ch {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border: 4px solid var(--line);
    border-radius: var(--r);
    background: var(--panel-2);
    transition:
      background 0.12s steps(2),
      color 0.12s steps(2);
  }
  .ch:hover {
    background: var(--sel);
    color: var(--sel-ink);
  }
  .ch .ico {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--panel);
    color: var(--ink);
    border: 4px solid var(--line);
    flex: none;
  }
  .ch .ico :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }
  .ch .lb {
    font: 700 9px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 4px;
  }
  .ch:hover .lb {
    color: var(--sel-ink);
  }
  .ch .vl {
    font: 400 15px/1.3 var(--font-mono);
    word-break: break-all;
  }

  @media (max-width: 1000px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
