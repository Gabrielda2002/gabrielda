---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";

// TODO: la lógica de validación y envío vivirá en
// `src/scripts/contact-form.ts` cuando el formulario se conecte. Por ahora
// este componente es SOLO visual: sin script, sin validación ni envío.
---

<form class="form panel reveal" id="form" novalidate data-contact-form>
  <div class="field" id="f-name">
    <label for="c-name">Nombre</label>
    <div class="ctl">
      <input
        type="text"
        id="c-name"
        name="name"
        placeholder="Tu nombre"
        autocomplete="name"
        required
      />
    </div>
    <div class="err" id="e-name" aria-live="polite"></div>
  </div>

  <div class="field" id="f-mail">
    <label for="c-mail">Email</label>
    <div class="ctl">
      <input
        type="email"
        id="c-mail"
        name="email"
        placeholder="tu@email.com"
        autocomplete="email"
        required
      />
    </div>
    <div class="err" id="e-mail" aria-live="polite"></div>
  </div>

  <div class="field" id="f-msg">
    <label for="c-msg">Mensaje</label>
    <div class="ctl">
      <textarea
        id="c-msg"
        name="message"
        placeholder="Cuéntame sobre tu proyecto..."
        required
      ></textarea>
    </div>
    <div class="err" id="e-msg" aria-live="polite"></div>
  </div>

  <Button variant="primary" type="submit">
    <Icon name="i-play" />
    Enviar mensaje
  </Button>

  <div
    class="status"
    id="status"
    role="status"
    aria-live="polite"
    data-contact-status
    hidden
  ></div>
</form>

<style>
  .form {
    padding: 24px;
  }
  .field {
    margin-bottom: 20px;
  }
  .field label {
    display: block;
    font: 700 10px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .field .ctl {
    position: relative;
  }
  .form input,
  .form textarea {
    width: 100%;
    padding: 14px;
    background: var(--panel-2);
    color: var(--ink);
    border: 4px solid var(--line);
    border-radius: 4px;
    font: 400 15px/1.5 var(--font-body);
    outline: none;
    transition:
      background 0.12s steps(2),
      border-color 0.12s steps(2);
  }
  .form input:focus,
  .form textarea:focus {
    background: var(--panel);
    border-color: var(--sel);
  }
  .form textarea {
    min-height: 120px;
    resize: vertical;
  }
  .err {
    margin-top: 8px;
    font: 700 10px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--coral);
    min-height: 14px;
  }
  .field.bad input,
  .field.bad textarea {
    border-color: var(--coral);
  }
  .status {
    margin-top: 16px;
    padding: 12px;
    border: 4px solid var(--line);
    border-radius: 4px;
    background: var(--panel-2);
    font: 700 10px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: none;
  }
  .status.show {
    display: block;
  }
  .status.ok {
    background: var(--lime);
    color: #10240c;
    border-color: var(--line);
  }
</style>
