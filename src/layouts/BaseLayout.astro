---
// Solo el subset `latin`: el contenido es español y todo su repertorio
// (incluidos á/é/í/ó/ú/ñ/ü/¿/¡) vive en Latin-1 (U+0000–00FF). Los archivos
// por subset de fontsource no declaran `unicode-range`, así que importar
// también `latin-ext` crearía dos @font-face con descriptores idénticos y el
// navegador usaría solo el último (sin los caracteres base).
import "@fontsource/press-start-2p/latin.css";
import "@fontsource/dotgothic16/latin.css";
import "../styles/global.css";
import SEO from "@/components/seo/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Tema día/noche aplicado ANTES del primer pintado (evita el FOUC).
      // Semántica fiel al original: el valor guardado gana; si no existe,
      // prefiere el esquema oscuro del sistema; en caso contrario, día.
      (function () {
        var root = document.documentElement;
        var KEY = "gd-theme";
        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        var t =
          stored === "night" || stored === "day"
            ? stored
            : window.matchMedia &&
                window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "night"
              : "day";
        root.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
